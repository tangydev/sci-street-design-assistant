    {
      "id": "lXLnaDa6y6O-KzXp0cluD",
      "type": "text",
      "x": 804.619293072283,
      "y": -532.1292580251031,
      "width": 1274.69980867944,
      "height": 191.20497130191598,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "at",
      "roundness": null,
      "seed": 40387221,
      "version": 256,
      "versionNonce": 982726261,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795554599192,
      "created": 1794775956023,
      "locked": false,
      "text": "The outcome: feasible, infeasible, or unresolved. \nThe recommended option, and how it compares with the others. \nThe cross-section of the chosen option: what the street would look like. \nThe checks, especially any that failed or are uncertain, and the rule behind each one. \nThe details: the width along the street, uncertainty bands, and sources. They only go this deep when\nsomething surprises them. ",
      "fontSize": 25.493996173588798,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The outcome: feasible, infeasible, or unresolved. \nThe recommended option, and how it compares with the others. \nThe cross-section of the chosen option: what the street would look like. \nThe checks, especially any that failed or are uncertain, and the rule behind each one. \nThe details: the width along the street, uncertainty bands, and sources. They only go this deep when something surprises them. ",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null,
      "hasTextLink": false,
